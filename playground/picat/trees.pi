% First we import solver. Either c(onstranint)p(rograming) or sat.
import sat.
%import cp.

% We have preprocessed all lca computations before and compile it in input file.
% In input file we have the following.
% input(N,T). where N = number of leaves and T = number of trees.
% lca(Tree, Node1, Node2, NodeLCA). Such that for Node1 and Node2 the NodeLCA is their common LCA in tree Tree.

% Computing the maximum agreement forest.
maximum_agreement_forest(NumberOfLeaves, NumberOfTrees, Cost, Constraints, Childrens, RootEdges, Roots, Es) =>
  
  %%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%% PRECOMPUTATION %%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%

  % Precompute table of lca values.
  % In table we have values {Tree, Label1, Label2, Value}, where it means that for Label1 and Label2 their lca in tree Tree is Value.
  % Also {Tree, 0, 0, 0} are fallback values if they are not present.
  NumberOfPossibleLabels = (NumberOfTrees + 1) * (NumberOfLeaves - 1) + 2,
  LcaTable = [{T, I, J, Val, 1} : T in 1..NumberOfTrees, I in 1..NumberOfPossibleLabels, J in 1..NumberOfPossibleLabels, I != J, lca(T,I,J,Val)] ++ [{T, 0, 0, 0, 1} : T in 1..NumberOfTrees],

  % Maximum number of possible nodes in the outputed tree.
  MaximumNumberOfNodes = 2 * NumberOfLeaves - 1,

  %%%%%%%%%%%%%%%%%%%%%%%
  %%%%% CONSTRAINTS %%%%%
  %%%%%%%%%%%%%%%%%%%%%%%

  % Set which vertices are active or not.
  ActiveVertices = new_array(MaximumNumberOfNodes),
  ActiveVertices :: 0..1,
  % Set all leaves to be active.
  foreach(I in 1..NumberOfLeaves)
      ActiveVertices[I] #= 1
  end,

  % For each node set an array of both its children.
  Childrens = new_array(2, MaximumNumberOfNodes - NumberOfLeaves),
  Childrens :: 0..MaximumNumberOfNodes,
  % Either their childs are unique or they are non existant.
  all_different_except_0(Childrens[1]),
  all_different_except_0(Childrens[2]),

  % Root to child edges. Count them.
  RootEdges = new_array(MaximumNumberOfNodes),
  RootEdges :: 0..1,
  % There is at most number of leaves many forests.
  count(1, RootEdges, #=<, NumberOfLeaves),
  Cost #= sum(RootEdges.vars()),

  % Values of lca for each node with respect to the trees.
  LcaValues = new_array(NumberOfTrees, MaximumNumberOfNodes),
  LcaValues :: 0..NumberOfPossibleLabels,
  % Values of lca has to either differ or be the same.
  foreach(I in 1..NumberOfTrees)
    all_different_except_0(LcaValues[I]),
    foreach(J in 1..NumberOfLeaves)
      LcaValues[I, J] #= J,
    end,
  end,

  Roots = new_array(MaximumNumberOfNodes),
  Roots :: 0..MaximumNumberOfNodes,

  %%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%% SET UP THE TREE %%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%

  % Set the vertex variables. Include 0 as virtual root.
  Vertices = [{0, 1}] ++ [{I, ActiveVertices[I]} : I in 1..MaximumNumberOfNodes],

  % Set the edge variables.
  Edges = [],
  % Add root to child edges. And conect them.
  foreach(Child in 1..MaximumNumberOfNodes)
      Edges := [{0, Child, RootEdges[Child]} | Edges]
  end,
  % Add all other edges and connect them to children.
  foreach(Parent in (NumberOfLeaves + 1)..MaximumNumberOfNodes)
      matrix_element(Childrens, 1, Parent-NumberOfLeaves, C1),
      matrix_element(Childrens, 2, Parent-NumberOfLeaves, C2),
      foreach(Child in (Parent + 1)..MaximumNumberOfNodes)
        B :: 0..1,
        Edges := [{Parent, Child, B}| Edges],
        % If there is an edge it must also be one of the childs.
        B #<=> (C1 #= Child #\/ C2 #= Child),
      end,
      foreach(Leaf in 1..NumberOfLeaves)
        B :: 0..1,
        Edges := [{Parent, Leaf, B}| Edges],
        % If there is an edge it must also be one of the childs.
        B #<=> (C1 #= Leaf #\/ C2 #= Leaf),
      end,
  end,

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%% SET THE TREE TO BE BINARY %%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  % We want the graph to be a tree.
  tree(Vertices, Edges),
  
  % Ensure that the tree is binary.
  % Here each leaf has exactly one ingoing edge.
  foreach(Leaf in 1..NumberOfLeaves)
      Intgoing = [B : {P, C, B} in Edges, C == Leaf],
      count(1, Intgoing, 1)
  end,
  % There is either 2 or 0 outgoing edges and at most one ingoing edge.
  foreach(Internal in (NumberOfLeaves + 1)..MaximumNumberOfNodes)
    Outgoing = [B : {P, C, B} in Edges, P == Internal],
    Ingoing = [B : {P, C, B} in Edges, C == Internal],
    count(1, Outgoing, #=<, 2),
    count(1, Outgoing, #!=, 1),
    count(1, Ingoing, #=<, 1)
  end,

  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  %%%%% CONNECT LCA COMPUTATION %%%%%
  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  % Compute LCAs.
  foreach(Tree in 1..NumberOfTrees, Node in NumberOfLeaves+1..MaximumNumberOfNodes)
    matrix_element(Childrens, 1, Node-NumberOfLeaves, C1),
    matrix_element(Childrens, 2, Node-NumberOfLeaves, C2),
    matrix_element(LcaValues, Tree, C1, LCA1),
    matrix_element(LcaValues, Tree, C2, LCA2),
    matrix_element(LcaValues, Tree, Node, LCA),
    % Lca values must match.
    table_in({Tree,LCA1, LCA2, LCA, 1}, LcaTable),
    % It must be strictly below.
    table_in([{Tree, LCA1, LCA, LCA, 1}, {Tree, LCA2, LCA, LCA, 1}], LcaTable)
  end,

  foreach(Node in 1..MaximumNumberOfNodes)
    RootEdges[Node] #= 1 #<=> Roots[Node] #= Node
  end,

  foreach(Parent in NumberOfLeaves + 1..MaximumNumberOfNodes)
      matrix_element(Childrens, 1, Parent-NumberOfLeaves, C1),
      matrix_element(Childrens, 2, Parent-NumberOfLeaves, C2),
      element(C1, Roots, R1),
      element(C2, Roots, R2),
      ActiveVertices[Parent] #=> (R1 #= Roots[Parent] #/\ R2 #= Roots[Parent])
  end,

  foreach(Tree in 1..NumberOfTrees, RootNode1 in NumberOfLeaves..MaximumNumberOfNodes, RootNode2 in RootNode1+1..MaximumNumberOfNodes)
    element(RootNode1, RootEdges, R1),
    element(RootNode2, RootEdges, R2),
    matrix_element(LcaValues, Tree, RootNode1, LCA1),
    matrix_element(LcaValues, Tree, RootNode2, LCA2),
    foreach(Leaf in 1..NumberOfLeaves)
      element(Leaf, Roots, Root),
      IsIn :: 0..1,
      IsIn #= 1 #<=> ((R1 #= 1 #/\ R2 #= 1) #/\ Root #= RootNode1),
      table_notin({Tree, Leaf, LCA2, LCA2, IsIn}, LcaTable)
    end
  end,
  
  Es = Edges,

  Constraints = [ActiveVertices, [B : {_, _, B} in Edges], LcaValues, Childrens, RootEdges, Roots].

newick_format_print(Cost, Childrens, RootEdges) =>
  printf("# Number of Trees: %d\n", Cost),
  print("# "), println(Childrens),
  print("# "), println(RootEdges).

main([File]) =>
  cl(File),
  input(N, T),
  maximum_agreement_forest(N, T, Cost, Constraints, Childrens, RootEdges, Roots, Es),
  solve([$min(Cost)], Constraints),
  println(Roots),
  println([{P,C} : {P, C, B} in Es, B == 1]),
  newick_format_print(Cost, Childrens, RootEdges).
