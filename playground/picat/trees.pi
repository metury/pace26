import sat.

% We have virtual root and all its trees from forest as its children.
% We use the global constraint tree(Vs, Es).
% * Here Both vertices and edges have boolen "active" part.

maf(NumLeaves, Cost, Active, Vs, Edges) =>
  MaxNodes = 2 * NumLeaves - 1,

  % Set virtual node and all leaves to be active.
  Active = new_list(MaxNodes),
  Active :: 0..1,
  foreach(I in 1..NumLeaves)
      Active[I] #= 1
  end,

  % Set the vertex variables.
  Vs = [{0, 1}] ++ [{I, Active[I]} : I in 1..MaxNodes],

  % Set the edge variables.
  Es = [],

  %% Root to child edges. Count them.
  RootEdges = new_array(MaxNodes),
  RootEdges :: 0..1,

  % Add root to child edges. And conect them.
  foreach(Child in 1..MaxNodes)
      Es := [{0, Child, RootEdges[Child]} | Es]
  end,

  V #= 1,
  count(V, RootEdges, #=<, NumLeaves),
  
  % Add all other edges.
  foreach(Parent in (NumLeaves + 1)..MaxNodes)
      foreach(Child in (Parent + 1)..MaxNodes)
        B :: 0..1,
        Es := [{Parent, Child, B}| Es]
      end,
      foreach(Leaf in 1..NumLeaves)
        B :: 0..1,
        Es := [{Parent, Leaf, B}| Es]
      end
  end,

  tree(Vs, Es),
  
  % Ensure that the tree is binary.
  foreach(Leaf in 1..NumLeaves)
      Outgoing = [B : {P, C, B} in Es, C == Leaf],
      count(V,Outgoing,1)
  end,

  foreach(Internal in (NumLeaves + 1)..MaxNodes)
    Outgoing = [B : {P, C, B} in Es, P == Internal],
    Ingoing = [B : {P, C, B} in Es, C == Internal],
    count(V, Outgoing, #=<, 2),
    count(V, Outgoing, #!=, 1),
    count(V, Ingoing, #=<, 1)
  end,

  Edges = Es,

  Cost #= sum(RootEdges.vars()).

fancy_print(Cost, Edges) =>
  printf("Number of Trees: %d\n", Cost),
  foreach({P, C, B} in Edges)
      if (B == 1) then
          printf("Edge: %d -- %d\n", P, C)
      end
  end.


main() =>
  maf(4, Cost, Active, Vs, Es),
  solve([$min(Cost)], [Active, [B : {_,_,B} in Es]]),  
  fancy_print(Cost, Es).

main([Nstr]) =>
  N := parse_term(Nstr),
  maf(N, Cost, Active, Vs, Es),
  solve([$min(Cost)], [Active, [B : {_, _, B} in Es]]),
  fancy_print(Cost, Es).
