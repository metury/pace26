import cp.

selection(VarSels) => VarSels = [backward,constr,degree,ff,ffc,ffd,forward,inout,label,leftmost,max,min,rand,rand_var,rand_val,reverse_split,split,updown].
choice(ValChoices) => ValChoices = [down,reverse_split,split,up,updown].

main() =>
  cl(trees),
	Ns = [5,6,7,8,9,10,12,14,16],
	selection(VarSels),
  choice(ValChoices),
  Strategies = [[VarSel, ValChoice] : VarSel in VarSels, ValChoice in ValChoices],
  Timeout = 1000,

  foreach(N in Ns)
    foreach(Strategy in Strategies)
      maf(N, Cost, Active, Vs, Es),
      Edges = [B : {_, _, B} in Es],
      time_out(solve([$min(Cost)] ++ Strategy, [Active, Edges]), Timeout, Status),
      if Status != success then
        Strategies := delete(Strategies, Strategy)
      end
    end,
    printf("N=%d: %w\n", N, Strategies),
  end.
